{
  "schema": 1,
  "plugin": "error-reporting",
  "notes": "eplus-plugin-catalog error-reporting 0.4.0. ${IDENTITY} is DOMAIN\\user@MACHINE computed by the runner the same way egress-common.ps1 does.",
  "cases": [
    { "id": "note-startup", "event": "SessionStart", "payload": { "source": "startup" },
      "expect": { "stdout": "json", "json_required": ["hookSpecificOutput.additionalContext"], "json_regex": { "hookSpecificOutput.additionalContext": "^\\[error-reporting\\] Reporter identity for this seat: " } } },
    { "id": "note-compact", "event": "SessionStart", "payload": { "source": "compact" },
      "expect": { "stdout": "json", "json_regex": { "hookSpecificOutput.additionalContext": "Reporter identity" } } },
    { "id": "note-hatch", "event": "SessionStart", "env": { "EPLUS_NO_IDENTITY_NOTE": "1" }, "expect": { "stdout": "empty" } },
    { "id": "note-global-hatch", "event": "SessionStart", "env": { "EPLUS_NO_ERROR_NUDGE": "1" }, "expect": { "stdout": "empty" } },

    { "id": "stamp-unknown-main", "event": "PreToolUse",
      "payload": { "tool_name": "mcp__error-reporting__report_issue" },
      "payload_replace": { "tool_input": { "message": "x failed", "category": "tool_failure", "tool_name": "search", "server_name": "rfi-knowledge-hub", "severity": "medium", "details": "Error: boom", "requested_by": "unknown" } },
      "expect": { "stdout": "json",
        "json_equals": { "hookSpecificOutput.permissionDecision": "allow", "hookSpecificOutput.updatedInput.requested_by": "${IDENTITY}", "hookSpecificOutput.updatedInput.message": "x failed" },
        "json_regex": { "hookSpecificOutput.updatedInput.details": "^Error: boom \\[seat session ${SESSION_ID}; env session ${SESSION_ID}; agent main\\]$", "hookSpecificOutput.additionalContext": "has been set to that value" } } },
    { "id": "stamp-subagent", "event": "PreToolUse",
      "payload": { "tool_name": "mcp__plugin_error-reporting_error-reporting__report_issue", "agent_id": "agent-9", "agent_type": "eplus-rfis-submittals:rfi-researcher" },
      "payload_replace": { "tool_input": { "message": "m", "requested_by": "" } },
      "expect": { "stdout": "json", "json_equals": { "hookSpecificOutput.permissionDecision": "allow", "hookSpecificOutput.updatedInput.requested_by": "${IDENTITY}" },
        "json_regex": { "hookSpecificOutput.updatedInput.details": "agent eplus-rfis-submittals:rfi-researcher\\]$" } } },
    { "id": "stamp-egress-keeps-supplied-name", "event": "PreToolUse",
      "payload": { "tool_name": "mcp__error-reporting__request_egress_allow" },
      "payload_replace": { "tool_input": { "host": "x.example", "url": "https://x.example/a", "purpose": "p", "user_goal": "g", "requested_by": "CORP\\jdoe@WS01" } },
      "expect": { "stdout": "json", "json_equals": { "hookSpecificOutput.permissionDecision": "allow", "hookSpecificOutput.updatedInput.requested_by": "CORP\\jdoe@WS01" },
        "json_regex": { "hookSpecificOutput.updatedInput.error_text": "^\\[seat session " } } },
    { "id": "stamp-already-tagged-context-only", "event": "PreToolUse",
      "payload": { "tool_name": "mcp__error-reporting__report_issue" },
      "payload_replace": { "tool_input": { "message": "m", "details": "x [seat session s; env session e; agent main]", "requested_by": "CORP\\jdoe@WS01" } },
      "expect": { "stdout": "json", "json_required": ["hookSpecificOutput.additionalContext"], "json_forbidden": ["hookSpecificOutput.permissionDecision", "hookSpecificOutput.updatedInput"] } },
    { "id": "stamp-utf8-roundtrip", "event": "PreToolUse",
      "payload": { "tool_name": "mcp__error-reporting__report_issue" },
      "payload_replace": { "tool_input": { "message": "café – señal", "details": "Fehler: überprüfen", "requested_by": "" } },
      "expect": { "stdout": "json", "json_equals": { "hookSpecificOutput.updatedInput.message": "café – señal" }, "json_regex": { "hookSpecificOutput.updatedInput.details": "^Fehler: überprüfen \\[seat session" } } },
    { "id": "stamp-hatch", "event": "PreToolUse", "payload": { "tool_name": "mcp__error-reporting__report_issue" }, "env": { "EPLUS_NO_IDENTITY_STAMP": "1" }, "expect": { "stdout": "empty" } },

    { "id": "fetch-blocked", "event": "PostToolUse",
      "payload": { "tool_name": "mcp__workspace__web_fetch" },
      "payload_replace": { "tool_input": { "url": "https://b.example/" }, "tool_response": [ { "type": "text", "text": "Host \"b.example\" is not on the network allowlist (cowork-egress-blocked). Ask your administrator" } ] },
      "expect": { "stdout": "json", "json_regex": { "hookSpecificOutput.additionalContext": "^\\[error-reporting\\] That failure is a network egress block" } } },
    { "id": "fetch-clean", "event": "PostToolUse",
      "payload": { "tool_name": "mcp__workspace__web_fetch" },
      "payload_replace": { "tool_input": { "url": "https://a.example/not on the network allowlist" }, "tool_response": [ { "type": "text", "text": "fetched fine" } ] },
      "expect": { "stdout": "empty" } },
    { "id": "fetch-plain-403-not-signature", "event": "PostToolUse",
      "payload": { "tool_name": "mcp__workspace__web_fetch" },
      "payload_replace": { "tool_input": { "url": "https://x" }, "tool_response": "HTTP 403: Forbidden" },
      "expect": { "stdout": "empty" } },
    { "id": "fetch-hatch", "event": "PostToolUse", "payload": { "tool_name": "mcp__workspace__web_fetch" }, "payload_replace": { "tool_response": "cowork-egress-blocked" }, "env": { "EPLUS_NO_EGRESS_NUDGE": "1" }, "expect": { "stdout": "empty" } },

    { "id": "failure-generic", "event": "PostToolUseFailure",
      "payload": { "tool_name": "mcp__workspace__bash", "error": "exit status 2" }, "payload_replace": { "tool_input": { "command": "ls /nope" } },
      "expect": { "stdout": "json", "json_regex": { "hookSpecificOutput.additionalContext": "^\\[error-reporting\\] An EPLUS tool call just failed.*Reporter identity for this seat: " } } },
    { "id": "failure-egress", "event": "PostToolUseFailure",
      "payload": { "tool_name": "mcp__workspace__web_fetch", "error": "Host \"x\" is not on the network allowlist (cowork-egress-blocked)" }, "payload_replace": { "tool_input": { "url": "https://x" } },
      "expect": { "stdout": "json", "json_regex": { "hookSpecificOutput.additionalContext": "^\\[error-reporting\\] That failure is a network egress block" } } },
    { "id": "failure-self-skip", "event": "PostToolUseFailure",
      "payload": { "tool_name": "mcp__plugin_error-reporting_error-reporting__report_issue", "error": "timeout" }, "payload_replace": { "tool_input": {} },
      "expect": { "stdout": "empty" } },
    { "id": "failure-hatch", "event": "PostToolUseFailure", "payload": { "tool_name": "mcp__workspace__bash", "error": "x" }, "env": { "EPLUS_NO_ERROR_NUDGE": "1" }, "expect": { "stdout": "empty" } }
  ]
}
